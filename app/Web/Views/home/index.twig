{% extends 'layout.twig' %}

{% block title %}Accueil{% endblock %}

{% block content %}
    <h1>Framework MVC pédagogique</h1>
    <p>Inscription / connexion, puis parcours authentifié avec liste des utilisateurs et exemple de todo list.</p>
    {% if auth_user %}
        <p>Bonjour {{ auth_user.username }}.</p>
        <p>
            <a class="button" href="{{ url('/users') }}">Voir les utilisateurs</a>
            <a href="{{ url('/todos') }}">Voir les tâches</a>
        </p>
    {% else %}
        <p>
            <a class="button" href="{{ url('/login') }}">Connexion</a>
            <a href="{{ url('/register') }}">Créer un compte</a>
        </p>
    {% endif %}
{% endblock %}
