{% extends 'layout.twig' %}

{% block title %}Accueil{% endblock %}

{% block content %}
    <h1>Framework MVC pédagogique</h1>
    <p>Inscription / connexion, puis todo list (accès connecté).</p>
    {% if auth_user %}
        <p>Bonjour {{ auth_user.name }}.</p>
        <p><a class="button" href="{{ url('/todos') }}">Voir les tâches</a></p>
    {% else %}
        <p>
            <a class="button" href="{{ url('/login') }}">Connexion</a>
            <a href="{{ url('/register') }}">Créer un compte</a>
        </p>
    {% endif %}
{% endblock %}
