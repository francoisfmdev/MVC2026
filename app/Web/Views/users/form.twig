{% extends 'layout.twig' %}

{% block title %}{{ user ? 'Modifier' : 'Créer' }} un utilisateur{% endblock %}

{% block content %}
    <h1>{{ user ? 'Modifier' : 'Créer' }} un utilisateur</h1>

    <form method="post" action="{{ action }}">
        {{ csrf_field() }}
        <label>
            Nom
            <input type="text" name="name" required value="{{ old.name ?? user.name ?? '' }}">
        </label>
        <label>
            Email
            <input type="email" name="email" required value="{{ old.email ?? user.email ?? '' }}">
        </label>
        <button type="submit">Enregistrer</button>
        <a href="{{ url('/users') }}">Annuler</a>
    </form>
{% endblock %}
