{% extends 'layout.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block content %}
    <h1>Utilisateurs</h1>
    <p><a class="button" href="{{ url('/users/create') }}">Nouveau</a></p>

    {% if users is empty %}
        <p>Aucun utilisateur.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td><a href="{{ url('/users/' ~ user.id) }}">{{ user.name }}</a></td>
                        <td>{{ user.email }}</td>
                        <td>
                            <a href="{{ url('/users/' ~ user.id ~ '/edit') }}">Modifier</a>
                            <form class="inline" method="post" action="{{ url('/users/' ~ user.id ~ '/delete') }}" onsubmit="return confirm('Supprimer ?');">
                                {{ csrf_field() }}
                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
