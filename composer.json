{
    "name": "pedago/mvc-framework",
    "description": "Framework MVC pédagogique PHP ^8.2 (AltoRouter, Twig, PDO)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "altorouter/altorouter": "^2.0",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Console\\": "console/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
